{
	"name": "use-countdown-react",
	"type": "module",
	"version": "2.0.0",
	"description": "Countdown react hook",
	"main": "build/index.js",
	"types": "build/types/index.d.ts",
	"exports": {
		".": {
			"types": "./build/types/index.d.ts",
			"default": "./build/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"build"
	],
	"author": "Ilia Chernetskii <ichernetskii@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ichernetskii/useCountdown.git"
	},
	"homepage": "https://github.com/ichernetskii/useCountdown#readme",
	"bugs": "https://github.com/ichernetskii/useCountdown/issues",
	"keywords": [
		"react",
		"countdown",
		"hook"
	],
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:package": "publint",
		"format": "eslint . --fix",
		"manual": "vite",
		"prepack": "yarn run build",
		"preversion": "yarn run lint && yarn run test",
		"version": "yarn run format && git add -A src",
		"postversion": "git push && git push --tags"
	},
	"peerDependencies": {
		"react": ">=16.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"publint": "^0.3.25",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"packageManager": "yarn@4.18.1"
}
